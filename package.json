{
    "name": "amazon-music-linux",
    "productName": "Amazon Music",
    "version": "2.0.1",
    "main": "./dist/main.js",
    "description": "unofficial amazon music player for linux",
    "scripts": {
        "clean": "rimraf dist release-builds",
        "build": "tsc && npm run copy-assets",
        "copy-assets": "copyfiles -u 1 \"src/**/*.html\" \"src/**/*.css\" dist && copyfiles \"assets/*\" dist",
        "watch": "tsc -w",
        "lint": "tsc --noEmit",
        "start": "npm run build && electron .",
        "package-linux": "npm run build && electron-packager . amazon-music-linux --overwrite --asar --platform=linux --arch=x64 --icon=assets/favicon.png --prune=true --out=release-builds --ignore=\"^/(src|release-builds|build|\\.github|\\.git)\" --download.mirrorOptions.mirror=https://github.com/castlabs/electron-releases/releases/download/",
        "deb": "electron-installer-debian --src release-builds/amazon-music-linux-linux-x64/ --arch amd64 --config build-config.json",
        "rpm": "electron-installer-redhat --src release-builds/amazon-music-linux-linux-x64/ --arch x86_64 --config build-config.json",
        "dist-deb": "npm run package-linux && npm run deb",
        "dist-rpm": "npm run package-linux && npm run rpm"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/espaker/amazon-music-linux.git"
    },
    "author": "Ojas Ahuja",
    "contributors": [
        "Ojas Ahuja <ahuja.ojas@gmail.com> (https://ojas.fi)",
        "Florian Dörr <flo@dörr.site> (https://dörr.site)",
        "Ian Mbae <ianmin2@live.com> (https://ianmin2.bixbyte.io)",
        "Espaker Kaminski<ianmin2@live.com> (https://espaker.com.br)"
    ],
    "license": "MPL-2.0",
    "bugs": {
        "url": "https://github.com/espaker/amazon-music-linux/issues"
    },
    "homepage": "https://github.com/espaker/amazon-music-linux#readme",
    "dependencies": {
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "copyfiles": "^2.4.1",
        "electron": "github:castlabs/electron-releases#v43.0.0+wvcus",
        "@electron/packager": "^20.0.4",
        "electron-installer-debian": "^4.0.0",
        "electron-installer-redhat": "^4.0.0",
        "rimraf": "^6.0.1",
        "typescript": "^5.9.3"
    }
}
